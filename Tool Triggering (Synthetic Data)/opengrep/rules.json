{
  "rules": [
    {
      "id": "orderkit-tainted-query",
      "languages": [
        "csharp"
      ],
      "severity": "WARNING",
      "message": "Untrusted public parameter reaches a query string without sanitisation. Planted flow 2, mirrored from InputSanitizer.BuildQuery.",
      "patterns": [
        {
          "pattern": "string.Format($FMT, $...ARGS)"
        },
        {
          "metavariable-regex": {
            "metavariable": "$FMT",
            "regex": "(?i)^\"\\s*SELECT\\b"
          }
        }
      ]
    },
    {
      "id": "orderkit-tainted-command",
      "languages": [
        "csharp"
      ],
      "severity": "WARNING",
      "message": "Untrusted collection element reaches command assembly. Planted flow 4, mirrored from InputSanitizer.BuildCommand.",
      "patterns": [
        {
          "pattern-inside": "public static string BuildCommand(...) { ... }\n"
        },
        {
          "pattern": "$SB.Append($ARG)"
        }
      ]
    },
    {
      "id": "orderkit-tainted-path",
      "languages": [
        "csharp"
      ],
      "severity": "WARNING",
      "message": "Untrusted public parameter reaches path assembly. Planted flow 3, mirrored from InputSanitizer.BuildReportPath.",
      "patterns": [
        {
          "pattern": "$ROOT.TrimEnd('/') + \"/\" + $NAME"
        }
      ]
    }
  ]
}
